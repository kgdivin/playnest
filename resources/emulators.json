    {
      "id": "azahar",
      "name": "Azahar",
      "systems": [
        "3ds"
      ],
      "exe": {
        "windows": [
          "azahar.exe"
        ],
        "linux": [
          "azahar"
        ]
      },
      "args": [
        "-f",
        "{rom}"
      ],
      "argsWindowed": [
        "{rom}"
      ],
      "versionProbe": "re:\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ\\x00+(2\\d{3}\\.\\d+(?:\\.\\d+)?)\\x00",
      "source": {
        "type": "github",
        "repo": "azahar-emu/azahar",
        "assets": [
          "(?i)windows-msvc.*\\.zip$",
          "(?i)windows.*\\.zip$"
        ]
      },
      "website": "https://azahar-emu.org/pages/download/",
      "requires": [
        "vcredist"
      ],
      "dataDirs": {
        "windows": [
          {
            "path": "{emudir}/user"
          },
          {
            "path": "%APPDATA%/Azahar"
          }
        ],
        "linux": [
          {
            "path": "%APPDATA%/azahar-emu"
          }
        ]
      },
      "saves": [
        "sdmc/Nintendo 3DS/*/*/title/*/*/data",
        "sdmc/Nintendo 3DS/*/*/extdata",
        "nand/data"
      ],
      "systemFiles": [
        {
          "label": "Clés AES (aes_keys.txt)",
          "path": "sysdata/aes_keys.txt",
          "required": false,
          "import": true,
          "help": "Nécessaire uniquement pour les jeux chiffrés."
        }
      ],
      "notes": "Successeur de Citra. Au premier lancement, Azahar propose de reprendre les données de Citra."
    },
