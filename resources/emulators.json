      "source": {
        "type": "page",
        "url": "https://dolphin-emu.org/download/",
        "assets": [
          "https://dl\\.dolphin-emu\\.org/releases/[^\"'<> ]+-x64\\.7z",
          "https://dl\\.dolphin-emu\\.org/builds/[^\"'<> ]+-x64\\.7z"
        ],
        "version": "dolphin-(?:master-)?([0-9][0-9a-z.\\-]*)-x64"
      },
      "website": "https://dolphin-emu.org/download/",
