        "vcredist",
        "7zip"
      ],
      "dataDirs": {
        "windows": [
          {
            "path": "{emudir}/User",
            "when": "{emudir}/portable.txt"
          },
          {
            "path": "%DOCUMENTS%/Dolphin Emulator"
          },
          {
            "path": "%APPDATA%/Dolphin Emulator"
          }
        ],
        "linux": [
          {
            "path": "%APPDATA%/dolphin-emu"
          }
        ]
      },
      "saves": [
        "GC",
        "Wii/title/*/*/data"
      ],
      "notes": "GameCube et Wii. Distribué en .7z : Playnest installe 7-Zip automatiquement si besoin."
