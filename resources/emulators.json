{
  "_comment": "Émulateurs pilotés par Playnest. Copie ce fichier dans le dossier de données (emulators.json) pour le modifier sans recompiler : une entrée avec le même id remplace celle-ci. Jetons des arguments : {rom}, {romdir}, {romname}, {emudir}, {system} (nom de la console pour cet émulateur, voir systemNames). Jetons des chemins : {emudir}, %APPDATA%, %LOCALAPPDATA%, %DOCUMENTS%, %HOME%. dataDirs : le premier dont 'when' (ou 'path') existe est utilisé. saves : chemins relatifs au dossier de données, '*' = n'importe quel dossier. source.type : github, gitlab ou page.",
  "defaults": {
    "n64": "rmg",
    "nds": "melonds",
    "3ds": "azahar",
    "gc": "dolphin",
    "wii": "dolphin",
    "wiiu": "cemu",
    "switch": "eden",
    "switch2": "lichii",
    "nes": "mesen",
    "snes": "snes9x",
    "gb": "mgba",
    "gbc": "mgba",
    "gba": "mgba"
  },
  "emulators": [
    {
      "id": "mesen",
      "name": "Mesen",
      "systems": [
        "nes",
        "snes",
        "gb",
        "gbc",
        "gba"
      ],
      "exe": {
        "windows": [
          "Mesen.exe"
        ],
        "linux": [
          "Mesen",
          "mesen"
        ]
      },
      "args": [
        "--fullscreen",
        "{rom}"
      ],
      "argsWindowed": [
        "{rom}"
      ],
      "source": {
        "type": "github",
        "repo": "nesdev-org/MesenCE",
        "assets": [
          "(?i)mesen.*windows.*aot.*\\.zip$",
          "(?i)mesen.*windows(?!.*(net6|win7)).*\\.zip$",
          "(?i)mesen.*win.*\\.zip$"
        ]
      },
      "website": "https://github.com/nesdev-org/MesenCE/releases",
      "dataDirs": {
        "windows": [
          {
            "path": "{emudir}",
            "when": "{emudir}/settings.json"
          },
          {
            "path": "%DOCUMENTS%/Mesen2"
          }
        ],
        "linux": [
          {
            "path": "%HOME%/.config/Mesen2"
          }
        ]
      },
      "saves": [
        "Saves",
        "SaveStates"
      ],
      "notes": "Le plus précis pour la NES, très bon aussi pour la Super Nintendo et les Game Boy. Aucun BIOS nécessaire."
    },
    {
      "id": "snes9x",
      "name": "Snes9x",
      "systems": [
        "snes"
      ],
      "exe": {
        "windows": [
          "snes9x-x64.exe",
          "snes9x.exe"
        ],
        "linux": [
          "snes9x-gtk",
          "snes9x"
        ]
      },
      "args": [
        "-fullscreen",
        "{rom}"
      ],
      "argsWindowed": [
        "{rom}"
      ],
      "source": {
        "type": "github",
        "repo": "snes9xgit/snes9x",
        "assets": [
          "(?i)snes9x-[\\d.]+-win32-x64\\.zip$",
          "(?i)snes9x.*x64.*\\.zip$"
        ]
      },
      "website": "https://www.snes9x.com/downloads.php",
      "dataDirs": {
        "windows": [
          {
            "path": "{emudir}"
          }
        ],
        "linux": [
          {
            "path": "%HOME%/.config/snes9x"
          }
        ]
      },
      "saves": [
        "Saves"
      ],
      "notes": "Super Nintendo : léger, compatible avec presque tous les jeux, démarre en une seconde. Aucun BIOS nécessaire."
    },
    {
      "id": "mgba",
      "name": "mGBA",
      "systems": [
        "gba",
        "gbc",
        "gb"
      ],
      "exe": {
        "windows": [
          "mGBA.exe"
        ],
        "linux": [
          "mgba-qt",
          "mgba"
        ]
      },
      "args": [
        "-f",
        "{rom}"
      ],
      "argsWindowed": [
        "{rom}"
      ],
      "source": {
        "type": "github",
        "repo": "mgba-emu/mgba",
        "assets": [
          "(?i)mGBA-[\\d.]+-win64\\.7z$",
          "(?i)mGBA-.*win64.*\\.(7z|zip)$"
        ]
      },
      "website": "https://mgba.io/downloads.html",
      "requires": [
        "7zip"
      ],
      "dataDirs": {
        "windows": [
          {
            "path": "{emudir}",
            "when": "{emudir}/portable.ini"
          },
          {
            "path": "%APPDATA%/mGBA"
          }
        ],
        "linux": [
          {
            "path": "%HOME%/.config/mgba"
          }
        ]
      },
      "notes": "Game Boy Advance, Game Boy Color et Game Boy : rapide et fidèle, idéal pour les hacks .gba. Fonctionne sans BIOS. Les sauvegardes .sav sont enregistrées à côté des jeux : Playnest les inclut dans ses copies."
    },
    {
