#include <winver.h>

IDI_ICON1 ICON "playnest.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,2,0,0
PRODUCTVERSION  3,2,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "FileDescription", "Playnest - game launcher"
            VALUE "FileVersion", "3.2.0"
            VALUE "InternalName", "Playnest"
            VALUE "OriginalFilename", "Playnest.exe"
            VALUE "ProductName", "Playnest"
            VALUE "ProductVersion", "3.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
